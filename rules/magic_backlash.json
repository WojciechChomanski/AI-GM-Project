{
  "meta": {
    "version": "0.1",
    "status": "PLACEHOLDER",
    "doc": "docs/MAGIC_BACKLASH.md",
    "hidden": true,
    "note": "Backlash tracks, sigil points and ritual debt live only in the Python backend. Foundry may show symptom text, never the numbers. Opposite-element cancelling is banned as a provisional default. Hunter Witch-Sight rules are not implemented (TODO)."
  },
  "opposite_element_cancelling": {
    "allowed": false,
    "status": "PROVISIONAL_DEFAULT",
    "rule": "A shared Thermal track is not a way to cancel frost with fire or fire with frost. While the track is below 0, Fire spells are refused; while it is above 0, Frost spells are refused. Counters and rest are the only way back toward 0."
  },
  "thermal": {
    "min": -10,
    "max": 10,
    "frost_direction": -1,
    "fire_direction": 1,
    "gains": { "light": 1, "standard": 2, "heavy": 3, "greater": 5 },
    "thresholds": {
      "3": { "fine_tasks": -5, "spellcraft": -5 },
      "5": { "all": -10, "stamina_regen_mult": 0.5, "hp_per_round": 1, "area_evidence_metres": 3 },
      "7": { "stamina_regen_mult": 0.0, "hp_per_round": 3, "toughness_test": true, "toughness_dc": 50 },
      "10": { "death_rounds": 1 }
    },
    "recovery_step_per_minutes_rest": 10,
    "counters": {
      "hot_iron": { "steps_toward_zero": 3, "hp_cost": 4, "fire_scar": 1 },
      "ice_bath": { "steps_toward_zero": 3, "stamina_cost": 10, "rounds": 1 },
      "brazier_or_snow": { "steps_toward_zero_per_round": 1 }
    }
  },
  "grave_chill": {
    "min": 0,
    "max": 10,
    "gains": { "light": 1, "standard": 2, "heavy": 3, "greater": 5 },
    "thresholds": {
      "4": { "agility": -10, "numb_hand": true },
      "7": { "max_hp_pct_until_long_rest": -10 },
      "10": { "lose": ["finger", "ear"], "permanent_penalty": -5 }
    },
    "recovery_step_per_minutes_rest": 60,
    "counters": {
      "warm_blood": { "steps_toward_zero": 3, "corruption": 2 },
      "salt_and_ash": { "steps_toward_zero": 2, "hp_cost": 3 }
    }
  },
  "blood": {
    "stigmata_hp_in_scene": 16,
    "stigmata_bleed_rate": 1,
    "stigmata_rounds": 3,
    "counters": {
      "cautery": { "hp_cost": 3, "fire_scar": 1, "stops_stigmata": true },
      "tourniquet": { "rounds_rest": 1, "stops_stigmata": true }
    }
  },
  "ritual": {
    "no_cost_while_casting": true,
    "debt_due": "next_dawn",
    "fever_night": true,
    "circle_splits_evenly": true,
    "remainder_to": "lead"
  },
  "sigils": {
    "points_per_heavy_or_greater_cast": 1,
    "points_on_track_cross": [5, 7],
    "sigil_ii_heavy_discount": 1,
    "sigil_ii_applies_to": "heavy",
    "tiers": {
      "1": { "at": 3, "name": "Sigil I", "visible": false },
      "2": { "at": 8, "name": "Sigil II", "visible": false, "heavy_discount": 1 },
      "3": { "at": 15, "name": "Sigil III", "visible": true, "concealable": ["glove", "collar"] },
      "4": { "at": 25, "name": "Branded", "visible": true, "concealable": false }
    },
    "glamour": {
      "corruption": 5,
      "duration": "one_scene",
      "hides_from": "ordinary_sight",
      "never_against": "Witch-Sight"
    }
  },
  "todo": [
    "Hunter Witch-Sight rules are not implemented. Glamour never fools Witch-Sight; how a hunter actually spots or contests a sigil is left for a later PR."
  ]
}
