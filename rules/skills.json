    "excluded": "Prayer/Rites: waits for the Cleric redesign",
    "format": "skills: {id: {name, stats[1-2], trained_only, tools (tier examples or null), restrictions {race, gender}, description, ...}}. Base = floor(average of stats)."
  },
  "rules": {
    "creation_picks": 6,
    "pick_bonus": 10,
    "xp_cost": {
      "common": 100,
      "trained_only": 200
    },
    "xp_never_raises_value": true,
    "untrained_mult": 0.5,
    "skill_max": 95,
    "growth": "rules/progression.json growth (uses_needed, failures x2, 1 point per skill per session)",
    "use_bar": {
      "thresholds": [
        50,
        150,
        400,
        900,
        2000
      ],
      "ranks": [
        "Familiar",
        "Practiced",
        "Seasoned",
        "Veteran",
        "Master"
      ]
    },
    "master_gate": {
      "free_until": 50,
      "master_margin": 10,
      "points_per_period": 5,
      "gold_per_target_point": 20,
      "reputation": [
        {
          "up_to": 60,
          "min": 20
        },
        {
          "up_to": 75,
          "min": 40
        },
        {
          "up_to": 95,
          "min": 60
        }
      ]
    },
    "cross_race": {
      "gold_mult": 5,
      "reputation_extra": 30,
      "points_per_period": 2,
      "requires_found_master": true,
      "note": "Only way to get a race-locked skill. Gender locks are absolute (magic rules)."
    },
    "tool_tiers": {
      "none": 30,
      "field_kit": 50,
      "proper_tools": 70,
      "workshop": 95
    },
    "tools_above_cap": "uses still fill the use bar but do not raise the value"
  },
