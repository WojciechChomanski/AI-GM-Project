<section class="breath-sheet">
  <div class="rivet tl"></div><div class="rivet tr"></div><div class="rivet bl"></div><div class="rivet br"></div>

  <header class="head">
    <div class="seal" data-action="editImage" data-edit="img" title="{{localize 'BREATH.ChangePortrait'}}">
      <img src="{{portrait}}" alt="{{actor.name}}"/>
    </div>
    <div class="who">
      <input class="name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'Name'}}"/>
      {{#if isCharacter}}
      <div class="idrow">
        <div>
          <label>{{localize "BREATH.Race"}}</label>
          <b>{{#if system.details.race}}{{system.details.race}}{{else}}<span class="muted">{{localize "BREATH.DropRace"}}</span>{{/if}}</b>
        </div>
        <div>
          <label>{{localize "BREATH.Gender"}}</label>
          <b>{{#if system.details.gender}}{{system.details.gender}}{{else}}<span class="muted">{{localize "BREATH.DropGender"}}</span>{{/if}}</b>
        </div>
        <div>
          <label>{{localize "BREATH.Class"}}</label>
          <b>{{#if system.details.class_name}}{{system.details.class_name}}{{else}}<span class="muted">{{localize "BREATH.DropClass"}}</span>{{/if}}</b>
        </div>
        <div>
          <label>{{localize "BREATH.Age"}}</label>
          <input name="system.details.age" type="number" value="{{system.details.age}}"/>
        </div>
      </div>
      {{#if lockNotice}}<p class="notice">{{lockNotice}}</p>{{/if}}
      {{/if}}
    </div>
  </header>

  <div class="cols">
    <div class="col-stats">
      <h2 class="sec">{{localize "BREATH.Attributes"}}</h2>
      <div class="stats">
        {{#each attributes}}
        <div class="stat">
          <span>{{label}}</span>
          <em title="{{localize 'BREATH.Cap'}} {{max}}">{{value}}<i>/{{max}}</i></em>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="side">
      <div class="pool hp">
        <div class="lbl">{{localize "BREATH.Health"}}</div>
        <div class="val">
          <input name="system.resources.hp.value" type="number" value="{{system.resources.hp.value}}"/>
          <span class="of">/ {{system.resources.hp.max}}</span>
          <div class="bar"><i style="width: {{hpPct}}%"></i></div>
        </div>
      </div>
      <div class="pool sta">
        <div class="lbl">{{localize "BREATH.Stamina"}}</div>
        <div class="val">
          <input name="system.resources.stamina.value" type="number" value="{{system.resources.stamina.value}}"/>
          <span class="of">/ {{system.resources.stamina.max}}</span>
          <div class="bar"><i style="width: {{staPct}}%"></i></div>
        </div>
      </div>
      <div class="pool carry">
        <div class="lbl">{{localize "BREATH.Carry"}}</div>
        <div class="val">
          <b>{{carriedWeight}}</b><span class="of">/ {{carryCapacity}} kg</span>
          <small>{{localize "BREATH.CarryHint"}}</small>
        </div>
      </div>
    </div>
  </div>

  {{#if features.length}}
  <h2 class="sec">{{localize "BREATH.Traits"}}</h2>
  <ul class="features">
    {{#each features}}
    <li><b>{{name}}</b>{{#if text}} — <span>{{text}}</span>{{/if}} <i>{{source}}</i></li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if skills.length}}
  <h2 class="sec">{{localize "BREATH.Skills"}}</h2>
  <ul class="skills">
    {{#each skills}}
    <li data-item-id="{{id}}"><a data-action="openItem">{{name}}</a> <em>{{localize "BREATH.Rank"}} {{rank}}</em></li>
    {{/each}}
  </ul>
  {{/if}}

  <h2 class="sec">{{localize "BREATH.Felt"}}</h2>
  <div class="felt">
    {{#each system.felt}}<p><b>{{topic}}:</b> {{text}}</p>
    {{else}}<p class="hint">{{localize "BREATH.FeltEmpty"}}</p>{{/each}}
  </div>

  <h2 class="sec">{{localize "BREATH.Combat"}}</h2>
  <div class="combat">
    <label>{{localize "BREATH.WeaponInHand"}} <input name="system.combat.weapon_in_hand" type="text" value="{{system.combat.weapon_in_hand}}"/></label>
    <label>{{localize "BREATH.Grip"}} <select name="system.combat.grip">{{selectOptions gripChoices selected=system.combat.grip localize=true}}</select></label>
    <label>{{localize "BREATH.Guard"}} <input name="system.combat.current_guard" type="text" value="{{system.combat.current_guard}}"/></label>
  </div>

  <h2 class="sec">{{localize "BREATH.Items"}}</h2>
  {{#each groups}}
  <h3 class="sub">{{label}}</h3>
  <ul class="items">
    {{#each items}}
    <li data-item-id="{{id}}"><img src="{{img}}" width="24" height="24" alt=""/> <a data-action="openItem">{{name}}</a>
      <a class="delete" data-action="deleteItem" title="{{localize 'Delete'}}">✕</a></li>
    {{/each}}
  </ul>
  {{else}}<p class="hint">{{localize "BREATH.DropItems"}}</p>
  {{/each}}

  <h2 class="sec">{{localize "BREATH.Biography"}}</h2>
  <prose-mirror name="system.biography" value="{{system.biography}}">{{{biography}}}</prose-mirror>
</section>
